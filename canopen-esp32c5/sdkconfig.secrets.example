# Copy to sdkconfig.secrets, replace every placeholder, and keep that file private.
# The build wrapper will use sdkconfig.local so the generated values do not
# overwrite the tracked development sdkconfig.
CONFIG_WIRELESS_GATEWAY_ENABLED=y
CONFIG_WIRELESS_AP_PASSWORD="<8-to-63-character-product-secret>"
CONFIG_WIRELESS_BLE_PASSKEY=0
CONFIG_WIRELESS_TCP_CONTROL_KEY_HEX="<exactly-64-nonzero-hex-digits>"
